    "name": "THRUM",
    "author": "mohfarzin@users.noreply.github.com",
    "description": "THRUM self-hosted heartbeat monitor. Clones from GitHub, builds the React UI, runs Gunicorn + Celery worker/beat in one container. Requires external PostgreSQL and Redis (panel DB/Redis eggs or URLs). Preferred full stack remains Docker Compose — see README.",
    "features": null,
    "docker_images": {
        "Python 3.12": "ghcr.io/parkervcp/yolks:python_3.12"
    },
    "file_denylist": [],
    "startup": "bash /home/container/pterodactyl/start.sh",
    "config": {
        "files": "{}",
        "startup": "{\n    \"done\": \"Listening at:\"\n}",
        "logs": "{}",
        "stop": "^C"
    },
    "scripts": {
        "installation": {
            "script": "#!/bin/bash\n# THRUM egg install — clone GitHub repo then build deps + frontend\nset -euo pipefail\n\napt-get update\napt-get install -y --no-install-recommends git curl ca-certificates gnupg\n\n# Node.js 22 for frontend build (install container only)\ncurl -fsSL https://deb.nodesource.com/setup_22.x | bash -\napt-get install -y --no-install-recommends nodejs\n\nmkdir -p /mnt/server\ncd /mnt/server\n\nif [ \"${USER_UPLOAD:-0}\" = \"true\" ] || [ \"${USER_UPLOAD:-0}\" = \"1\" ]; then\n  echo \"USER_UPLOAD set; skipping git clone\"\n  exit 0\nfi\n\nGIT_ADDRESS=\"${GIT_ADDRESS:-https://github.com/MohFarzin/Thrum.git}\"\nif [[ \"${GIT_ADDRESS}\" != *.git ]]; then\n  GIT_ADDRESS=\"${GIT_ADDRESS}.git\"\nfi\n\nif [ -n \"${USERNAME:-}\" ] && [ -n \"${ACCESS_TOKEN:-}\" ]; then\n  GIT_ADDRESS=\"https://${USERNAME}:${ACCESS_TOKEN}@$(echo \"${GIT_ADDRESS}\" | cut -d/ -f3-)\"\nfi\n\nif [ \"$(ls -A /mnt/server)\" ]; then\n  if [ -d .git ]; then\n    echo \"Existing git repo; pulling\"\n    git pull --ff-only || true\n  else\n    echo \"/mnt/server is not empty and has no .git; refusing to overwrite\"\n    exit 10\n  fi\nelse\n  if [ -z \"${BRANCH:-}\" ]; then\n    git clone \"${GIT_ADDRESS}\" .\n  else\n    git clone --single-branch --branch \"${BRANCH}\" \"${GIT_ADDRESS}\" .\n  fi\nfi\n\nbash /mnt/server/pterodactyl/install.sh /mnt/server\n",
            "container": "python:3.12-bookworm",
            "entrypoint": "bash"
        }
    },
