# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
THRUM_PUBLIC_BASE_URL=http://localhost

# Postgres
POSTGRES_DB=thrum
POSTGRES_USER=thrum
POSTGRES_PASSWORD=thrum
DATABASE_URL=postgres://thrum:thrum@db:5432/thrum

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Email (SMTP) — unused until Phase 4
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=thrum@localhost

# Retention / defaults (Phase 5+)
THRUM_CHECK_RETENTION_DAYS=14
THRUM_DEFAULT_CHECK_INTERVAL_SECONDS=60
