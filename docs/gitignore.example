# Copy to repo root as `.gitignore` (that file stays local — not pushed).
# Env / secrets — never push these
.env
.env.*
!.env.example
.envrc
*.pem
*.ppk
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials.json
**/secret_key.txt
data/
.secrets/
local-notes*
*.local.md

# Keep the live ignore file off GitHub
.gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.sqlite3

# Node
node_modules/
frontend/dist/
*.log
npm-debug.log*

# Local-only build brief (agents use it; never publish)
thrum-plan.txt

# IDE / OS / Cursor (local agent canon — never push)
.cursor/
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

