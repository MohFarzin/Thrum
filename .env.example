# Django — leave SECRET_KEY empty (or "auto") and THRUM generates one on first start.
# Saved under data/secret_key.txt (gitignored). Never commit real secrets.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
THRUM_PUBLIC_BASE_URL=http://localhost
# Set True behind HTTPS (Compose TLS / reverse proxy). Keep False for plain HTTP panel ports.
SESSION_COOKIE_SECURE=False

# Postgres
POSTGRES_DB=thrum
POSTGRES_USER=thrum
POSTGRES_PASSWORD=thrum
DATABASE_URL=postgres://thrum:thrum@db:5432/thrum

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Email (SMTP) — required only for Email alert channels
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=thrum@localhost

# Used in alert message links
# THRUM_PUBLIC_BASE_URL=http://your-host:port

# Retention / check defaults
THRUM_CHECK_RETENTION_DAYS=14
THRUM_DEFAULT_CHECK_INTERVAL_SECONDS=60
THRUM_FAILURES_BEFORE_DOWN=2
